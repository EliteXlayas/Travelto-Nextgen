{
  "schemaVersion": 1,
  "id": "travelto",
  "version": "${version}",
  "name": "Travelto",
  "icon": "assets/travelto/branding/logo8-256.png",
  "description": "Travelto home, HUD and local presentation settings.",
  "environment": "client",
  "entrypoints": {
    "client": [{ "adapter": "kotlin", "value": "dev.travelto.Travelto" }]
  },
  "mixins": ["travelto.mixins.json"],
  "jars": [
    { "file": "META-INF/jars/modernui.jar" },
    { "file": "META-INF/jars/forgeconfigapiport.jar" }
  ],
  "depends": {
    "minecraft": "26.3",
    "java": ">=25",
    "fabricloader": ">=0.20.1",
    "fabric-language-kotlin": ">=1.14.2+kotlin.2.4.21",
    "fabric-api": ">=0.166.2+26.3",
    "modernui": "=3.14.9.1",
    "forgeconfigapiport": ">=26.3.0"
  }
}
